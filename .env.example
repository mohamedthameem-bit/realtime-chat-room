# ==============================================================
# Real-Time Chat Room — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================

# MongoDB connection string (required)
# Local:  mongodb://localhost:27017/chatroom
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chatroom?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/chatroom

# Port the Express server will listen on (default: 3000)
PORT=3000

# Comma-separated list of allowed CORS origins
# For local dev: http://localhost:3000
# For production: https://your-deployed-frontend.com
CORS_ORIGIN=http://localhost:3000

# Node environment: development | production
NODE_ENV=development

# JWT secret key — use a long, random string in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# JWT token lifetime (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d
